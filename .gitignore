# 依赖
node_modules/
package-lock.json.bak

# 打包产物（体积大，不进源码仓库）
dist/
out/

# 系统与编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/

# 本地环境
.env
.env.local
*.log

# 测试与临时产物
qa/
*.tmp
.playwright-mcp/

# 调试脚本一律放 qa/dev-scripts/，不要散落在仓库根目录
# （根目录只放正式工具，如 mock-ai.js 这类需要手动启动的本地服务）
/*.js
!/mock-ai.js

# 工具生成的元数据
*.artifact.json

# 开发过程中的临时拆分文件（内容已合并进主文件）
assets/*.part.js
assets/*.part.html

# 会话中的临时截图与导出样例（不参与构建）
*.webp
智批作文-*.html
局部截取_*.png
msedge.exe_*.webp
