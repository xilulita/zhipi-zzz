{
  "name": "ziweixing",
  "version": "1.5.3",
  "description": "紫微星 · AI 作文批改桌面版",
  "private": true,
  "license": "MIT",
  "main": "electron/main.js",
  "author": "紫微星",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xilulita/zhipi-zzz.git"
  },
  "bugs": {
    "url": "https://github.com/xilulita/zhipi-zzz/issues"
  },
  "homepage": "https://github.com/xilulita/zhipi-zzz#readme",
  "keywords": [
    "electron",
    "作文批改",
    "ai",
    "education"
  ],
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.zhipi.zuowen.desktop",
    "productName": "ziweixing",
    "artifactName": "ziweixing-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "!assets/*.part.*",
      "!assets/.*.artifact.json",
      "!assets/_side_font_bump.css",
      "!assets/export_print.css",
      "!assets/*.part.js",
      "!assets/*.part.html",
      "!assets/vendor/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "app-brand.ico"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "紫微星",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "紫微星",
      "include": "build/installer.nsh",
      "unicode": true
    }
  }
}
